# ─── Database ───────────────────────────────────────────────────
# Local SQLite database path (relative to prisma schema)
DATABASE_URL="file:../db/custom.db"

# ─── Email (Nodemailer SMTP) ────────────────────────────────────
# Optional: Fill these in for real email delivery via SMTP.
# Leave SMTP_HOST empty to use in-app simulation mode (outbox log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=

# ─── App Configuration ──────────────────────────────────────────
# Public base URL used in email links (invite, reset, digests).
# On Vercel, this will automatically fall back to https://${VERCEL_URL}
APP_URL=http://localhost:3000

# Set to "true" to force Secure cookie flag behind HTTPS (auto-enabled in production)
COOKIE_SECURE=

# Shared secret for scheduled cron calls (/api/digest/cron)
# For Vercel Cron, you can set CRON_SECRET in Vercel project environment variables
DIGEST_CRON_SECRET=pos_cron_dev_secret_change_me
CRON_SECRET=
