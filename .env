# ─── Database (independent — SQLite, zero external services) ────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Email (Nodemailer SMTP) ────────────────────────────────────
# Fill these in to switch from simulation mode to real email delivery.
# Gmail example: enable 2FA, create an App Password, then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# Leave SMTP_HOST empty to stay in simulation mode (emails are rendered
# and stored in the Digest outbox without being sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=

# ─── App ────────────────────────────────────────────────────────
# Public base URL used in email links (invite, reset, digests).
APP_URL=http://localhost:3000
# Set to "true" behind HTTPS to mark the session cookie Secure.
COOKIE_SECURE=
# Shared secret for the digest-cron mini-service → portal callback.
DIGEST_CRON_SECRET=pos_cron_dev_9f2c41ab77e54d0eaa01
